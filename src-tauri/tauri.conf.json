{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentlings",
  "version": "0.1.0",
  "identifier": "dev.cristiandonofrio.agentlings",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      { "title": "Agentlings", "width": 1000, "height": 720 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
